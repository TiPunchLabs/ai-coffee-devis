# direnv + pass — AgentMail credentials for the AI Coffee demo (never on disk).
# Dedicated AI Coffee inbox only: never reuse Scout's inbox or key.
#
# Requires these pass entries (see docs/AGENTMAIL.md):
#   pass show agentmail/ai-coffee-api-key     # API key of the AI Coffee inbox
#   pass show agentmail/ai-coffee-inbox-id    # full address, e.g. ai-coffee-gwada@agentmail.to
#
# The "Démo préparée" tab works without them.
# After editing this file, run:  direnv allow
export AGENTMAIL_API_KEY=$(pass agentmail/ai-coffee-api-key)
export AGENTMAIL_INBOX_ID=$(pass agentmail/ai-coffee-inbox-id)
